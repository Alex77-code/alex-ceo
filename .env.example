# Database
DATABASE_URL=postgresql://user:password@localhost:5432/alex_ceo_db

# API Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# OpenAI
OPENAI_API_KEY=sk-...

# Gmail
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=...
GOOGLE_CALENDAR_CLIENT_SECRET=...
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/auth/google-calendar/callback

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=...
GOOGLE_DRIVE_CLIENT_SECRET=...
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/auth/google-drive/callback

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=...
GOOGLE_ADS_CLIENT_ID=...
GOOGLE_ADS_CLIENT_SECRET=...

# Meta (Facebook)
META_ACCESS_TOKEN=...
META_BUSINESS_ACCOUNT_ID=...

# Stripe
STRIPE_SECRET_KEY=sk_...
STRIPE_PUBLISHABLE_KEY=pk_...

# WhatsApp Business API
WHATSAPP_BUSINESS_API_KEY=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...

# CRM Integration
CRM_API_KEY=...
CRM_BASE_URL=...

# Accounting/Finance System
ACCOUNTING_API_KEY=...
ACCOUNTING_BASE_URL=...

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Frontend
VITE_API_URL=http://localhost:3001/api

# Analytics
SENTRY_DSN=

# Feature Flags
FEATURE_VOICE_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false
FEATURE_AUTO_APPROVAL_ENABLED=false
